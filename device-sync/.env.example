# ── Hikvision device — one terminal, two interfaces ───────────────────────
# LAN is used whenever it answers; Wi-Fi only while LAN does not.
# (DEVICE_IP is still read as an alias for DEVICE_LAN_IP.)
DEVICE_LAN_IP=192.168.15.15
DEVICE_WIFI_IP=192.168.116.115
DEVICE_PORT=443
DEVICE_USERNAME=admin
DEVICE_PASSWORD=
DEVICE_USE_HTTPS=true
# How long one interface gets before the other is tried
DEVICE_CONNECT_TIMEOUT_MS=3000
DEVICE_REQUEST_TIMEOUT_MS=30000

# ── Backend selection ─────────────────────────────────────────────────────
# supabase (default, current production) | odoo (staging / post-cutover)
# See the "Device-Sync Odoo Bridge" plan and README.md "Backend toggle" section.
BACKEND=supabase

# ── Supabase backend (used when BACKEND=supabase, and always for the local
#    polling-cursor bootstrap + /api/device/* management routes) ───────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Odoo ───────────────────────────────────────────────────────────────────
# ODOO_API_BASE/ODOO_DB are also used to verify the caller's Odoo JWT on every
# write under /api/device/* (Hikvision employee-number hand-off §4.4), even
# when BACKEND=supabase — leaving them unset means those routes 401 every
# request rather than silently trusting any LAN caller.
# Service-account credentials — create with:
#   ./odoo-bin shell -c <conf> -d <DB> < ../../Lugal-ai/scripts/hr_migration/setup_device_sync_service_account.py
ODOO_API_BASE=https://your-odoo-host
ODOO_DB=
ODOO_SYNC_USERNAME=svc-device-sync
ODOO_SYNC_PASSWORD=

# When BACKEND=odoo: an unknown terminal number becomes an onboarding Odoo
# employee automatically (true, default — keep only for the transition) or is
# only reported via an "unknown terminal user" notification (false, the
# target — see the hand-off's order of work, §7).
AUTO_CREATE_UNKNOWN_EMPLOYEES=true

# ── Sync scheduling ────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=5
FULL_RECONCILE_MINUTES=30
EMPLOYEE_SYNC_MINUTES=60
TIMEZONE=Asia/Baghdad
TZ_OFFSET_HOURS=3

# ── Push listener (device -> this service) ────────────────────────────────
PUSH_LISTENER_PORT=8089
PUSH_LISTENER_ENABLED=true
