# Odoo backend (required)
VITE_API_BASE=https://your-odoo-host
VITE_ODOO_DB=your_database_name

# Biometric device-sync sidecar
# Production / remote (India): same-origin path proxied to Iraq :8089
VITE_SYNC_API=/device-api
# Local LAN only (service running on this machine):
# VITE_SYNC_API=http://localhost:8089/api
