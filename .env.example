# ─── Odoo backend (required) ───────────────────────────────────────────
# This single value drives BOTH the Vite dev proxy target (vite.config.ts)
# and the production build's absolute API host (src/shared/api/client.ts).
# Without it the app throws "VITE_API_BASE is not configured" on every call.
#
# Shared dev server:
# VITE_API_BASE=https://dev-crm.nooralnibras.com
#
# Odoo running on your own machine:
# VITE_API_BASE=http://localhost:8069
#
# Odoo on another machine on your LAN (use that machine's IP):
# VITE_API_BASE=http://192.168.1.50:8069
VITE_API_BASE=https://your-odoo-host

# Database name. Must match a database that exists on VITE_API_BASE and be
# the one the server's `dbfilter` resolves to.
VITE_ODOO_DB=your_database_name

# ─── Biometric device-sync sidecar ─────────────────────────────────────
# Path the browser calls. Leave as /device-api to go through the proxy.
VITE_SYNC_API=/device-api

# Where the proxy forwards /device-api. Only set this if your sync service
# is somewhere other than the Iraq LAN host (the built-in default).
# VITE_DEVICE_TARGET=http://localhost:8089
