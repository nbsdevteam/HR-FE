# Supabase mode (default when VITE_API_BASE is unset)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Odoo mode — set VITE_API_BASE to switch the SPA to Lugal HR APIs
# VITE_API_BASE=https://your-odoo-host
# VITE_ODOO_DB=your_database_name

# Optional biometric sidecar (device-sync)
# VITE_SYNC_API=http://localhost:8089
